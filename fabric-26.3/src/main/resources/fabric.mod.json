  "name": "AntOS",
  "description": "An ant-themed computer with apps, games, and data-driven content.",
  "authors": ["CraisinLord"],
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["com.craisinlord.antos.fabric.AntOSFabric"],
    "client": ["com.craisinlord.antos.fabric.client.AntOSFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
